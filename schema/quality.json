{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oraylis.de/datam8/schema/quality.json",
  "title": "Quality",
  "description": "Fixed SQL quality contract. Solutions translate expressions and queries to their target runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks"
  ],
  "properties": {
    "maxFailureRatePct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Fail after valid target and metric writes when the distinct error-row percentage strictly exceeds this value. Omit to disable the gate."
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/QualityCheck"
      }
    },
    "references": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/QualityReference"
      },
      "description": "Named active model entities, used in monitoring SQL as {references.alias}."
    }
  },
  "definitions": {
    "QualityReference": {
      "title": "QualityReference",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityId"
      ],
      "properties": {
        "entityId": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "QualityCheck": {
      "title": "QualityCheck",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "execution",
        "expression"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "execution": {
          "type": "string",
          "enum": [
            "enforcement",
            "monitoring"
          ]
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Boolean SQL expression. Only TRUE passes; FALSE and NULL are violations."
        },
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ],
          "description": "Defaults to error when omitted."
        },
        "description": {
          "type": "string"
        },
        "sql": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "Monitoring-only query returning exactly one row with checked_rows and measured_value. Uses {target} and declared {references.alias} relations."
        },
        "onEmpty": {
          "type": "string",
          "enum": [
            "evaluate",
            "no_data"
          ],
          "description": "Only with sql. Defaults to evaluate; no_data reports NO_DATA when checked_rows is zero after technical validation."
        }
      },
      "if": {
        "anyOf": [
          {
            "required": [
              "sql"
            ]
          },
          {
            "required": [
              "onEmpty"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "sql"
        ],
        "properties": {
          "execution": {
            "const": "monitoring"
          }
        }
      }
    }
  }
}
