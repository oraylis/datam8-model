{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oraylis.de/datam8/schema/quality.json",
  "title": "Quality",
  "description": "Tool-neutral entity quality configuration. Generator targets interpret rule definitions and target options.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks"
  ],
  "properties": {
    "settings": {
      "title": "QualitySettings",
      "type": "object",
      "additionalProperties": true,
      "description": "Common quality settings plus open target-specific options.",
      "if": {
        "required": [
          "maxFailureRatePct"
        ]
      },
      "then": {
        "properties": {
          "maxFailureRatePct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Stop dependent processing after writing valid rows when the distinct error-row percentage strictly exceeds this value. Omit to disable the gate."
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/QualityCheck"
      }
    },
    "referenceDatasets": {
      "type": "object",
      "description": "Named data references. Targets interpret binding details; entityId and execution are optional shared reference metadata.",
      "additionalProperties": {
        "title": "QualityReference",
        "type": "object",
        "additionalProperties": true,
        "if": {
          "anyOf": [
            {
              "required": [
                "entityId"
              ]
            },
            {
              "required": [
                "execution"
              ]
            }
          ]
        },
        "then": {
          "properties": {
            "entityId": {
              "type": "integer",
              "minimum": 0
            },
            "execution": {
              "enum": [
                "enforcement",
                "monitoring"
              ]
            }
          }
        }
      }
    }
  },
  "definitions": {
    "QualityCheck": {
      "title": "QualityCheck",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "execution",
        "definition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "execution": {
          "enum": [
            "enforcement",
            "monitoring"
          ]
        },
        "description": {
          "type": "string"
        },
        "definition": {
          "type": "object",
          "additionalProperties": true,
          "description": "Opaque rule configuration interpreted and validated by the selected generator target. No tool-specific keys or functions are prescribed by this schema."
        }
      }
    }
  }
}
